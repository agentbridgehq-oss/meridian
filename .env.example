PORT=8891
PUBLIC_BASE_URL=https://your-meridian.up.railway.app
DATA_DIR=/data

# Ops dashboard auth
OPS_TOKEN=change-me-long-random

# Dual delivery
RESEND_API_KEY=
EMAIL_FROM=Meridian <onboarding@resend.dev>
MERIDIAN_WEBHOOK_URL=
MERIDIAN_WEBHOOK_SECRET=

# Stripe (optional — checkout works when set)
STRIPE_SECRET_KEY=
# Optional fixed price IDs; else dynamic price_data
# STRIPE_PRICE_VOICE=
# STRIPE_PRICE_SALES=
# STRIPE_PRICE_BOOKING=
# STRIPE_PRICE_STACK=

# OpenClaw
MERIDIAN_OPENCLAW_AUTO=1

# Voice — PLATFORM ONLY right now (Retell / Vapi / Bland)
# Do NOT set VOICE_ENABLE_ELEVENLABS=1 until you want the optional plug-in
# VOICE_ENABLE_ELEVENLABS=0
# ELEVENLABS_API_KEY=

# Auto-deploy (OpenClaw drains data/deploy-queue.json)
# MERIDIAN_OPENCLAW_AUTO_DEPLOY=1
# MERIDIAN_DEPLOY_MAX=5

