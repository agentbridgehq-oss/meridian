PORT=8891
PUBLIC_BASE_URL=https://your-meridian.up.railway.app
DATA_DIR=/data

# Ops dashboard auth
OPS_TOKEN=change-me-long-random

# ── AI provider (Kenny 2026-10-04: all Meridian AI on xAI — one bill) ───────
# xai (default): Grok text brain + Grok Voice over SIP (Twilio Elastic SIP trunk
#   origination → sip:{number}@sip.voice.x.ai;transport=tls).
# legacy: previous Claude → Groq brain + OpenAI Realtime voice (rollback only).
MERIDIAN_AI_PROVIDER=xai
XAI_API_KEY=
# Signing secret returned ONCE by POST https://api.x.ai/v2/phone-numbers
# (origin "byo_trunk", webhook https://<host>/api/xai/webhooks/realtime).
XAI_WEBHOOK_SECRET=
# Brain model (function calling, 1M ctx, $1.25/$2.50 per 1M tokens as of 2026-10-04).
XAI_TEXT_MODEL=grok-4.3
# Voice model, pinned ($0.08/min as of 2026-10-04). grok-voice-latest aliases it.
XAI_VOICE_MODEL=grok-voice-think-fast-2.0
# XAI_VOICE_DEFAULT=eve
# XAI_VOICE_REASONING_EFFORT=

# ── Legacy voice stack (rollback: MERIDIAN_AI_PROVIDER=legacy) ──────────────
# OpenAI Realtime handles production speech/reasoning over SIP/WebRTC.
# Never commit real values. Store them in Railway/provider secret storage.
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Premium voice defaults. OpenAI currently recommends marin and cedar for
# highest built-in voice quality. Values are server-owned; browsers cannot
# override the model, voice, instructions, tools, or customer deployment.
MERIDIAN_VOICE_DEFAULT_VOICE=marin
MERIDIAN_VOICE_DEFAULT_SPEED=1
MERIDIAN_VOICE_VAD_THRESHOLD=0.5
MERIDIAN_VOICE_PREFIX_PADDING_MS=300
MERIDIAN_VOICE_SILENCE_MS=450
MERIDIAN_VOICE_IDLE_TIMEOUT_MS=8000

# Keep live SIP routing in staging until a real call passes acceptance tests.
MERIDIAN_VOICE_ENVIRONMENT=staging

# Browser Try Voice is deliberately opt-in. The demo uses far-field noise
# reduction + semantic VAD, no business tools, and explicit microphone consent.
MERIDIAN_VOICE_DEMO_ENABLED=0
MERIDIAN_VOICE_DEMO_MODEL=gpt-realtime-2.1
MERIDIAN_VOICE_DEMO_VOICE=marin
MERIDIAN_VOICE_DEMO_SPEED=1
MERIDIAN_VOICE_DEMO_VAD_EAGERNESS=medium
MERIDIAN_VOICE_DEMO_MAX_STARTS_PER_10M=3

# Customer CRM/calendar connectors. Meridian never stores connector secrets in
# the deployment ledger. For a verified webhook/n8n integration, create the
# deterministic secret env var shown by Ops, for example:
# MERIDIAN_CONNECTOR_DEP_0123ABC_CRM_SECRET=
# MERIDIAN_CONNECTOR_DEP_0123ABC_CALENDAR_SECRET=
# The customer endpoint must use HTTPS in production and return JSON with
# {"ok":true,"confirmed":true} before Meridian may report an action succeeded.

# Reserved for the upcoming OpenAI text/Responses adapter. The current legacy
# agent-brain module still uses its existing providers until that migration lands.
OPENAI_TEXT_MODEL=gpt-5.6-terra

# Twilio phone/SIP layer. Existing SMS/Gather code uses AUTH_TOKEN; the SIP
# control-plane path can use a restricted Twilio API key/secret where supported.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_TOKEN=
# JSON map of Twilio number → legacy Meridian agent id (legacy path only)
# TWILIO_AGENT_MAP={"+14155550100":"agent_xxx"}
# MERIDIAN_SMS_ALERTS=1
# TWILIO_SKIP_SIGNATURE=1

# Dual delivery / operator notifications
RESEND_API_KEY=
EMAIL_FROM=Meridian <onboarding@resend.dev>
MERIDIAN_WEBHOOK_URL=
MERIDIAN_WEBHOOK_SECRET=

# Stripe (optional until billing checkout is required)
STRIPE_SECRET_KEY=
# Pricing is CAD and lives in lib/pricing.mjs (single source of truth).
# Optional Stripe Price IDs (currency CAD). When blank, checkout sends inline
# CAD price_data built from lib/pricing.mjs, so amounts can never drift.
STRIPE_PRICE_RESCUE_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_SETUP=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_SETUP=
STRIPE_PRICE_BLOCK_MINUTES_100=
STRIPE_PRICE_BLOCK_SMS_500=
STRIPE_WEBHOOK_SECRET=

# OpenClaw
MERIDIAN_OPENCLAW_AUTO=1

# ── Legacy brain providers (used only when MERIDIAN_AI_PROVIDER=legacy) ─────
ANTHROPIC_API_KEY=
# MERIDIAN_LLM_MODEL=
GROQ_API_KEY=

# XAI_API_KEY (above) also powers hosted Grok TTS previews and the site guide.

# Website Play on Netlify. Production phones still require Railway.
# Store the real key only in Netlify / Railway secret storage.
VOICE_ENABLE_ELEVENLABS=1
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ARA=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_EVE=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_LEO=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_REX=pNInz6obpgDQGcFmaJgB
PUBLIC_SITE_ORIGIN=https://meridian-open.netlify.app
