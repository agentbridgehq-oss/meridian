PORT=8891
PUBLIC_BASE_URL=https://your-meridian.up.railway.app
DATA_DIR=/data

# Ops dashboard auth
OPS_TOKEN=change-me-long-random

# Dual delivery
RESEND_API_KEY=
EMAIL_FROM=Meridian <onboarding@resend.dev>
MERIDIAN_WEBHOOK_URL=
MERIDIAN_WEBHOOK_SECRET=

# Stripe (optional — checkout works when set)
STRIPE_SECRET_KEY=

# OpenClaw
MERIDIAN_OPENCLAW_AUTO=1

# Claude brain — required. Without this, agents silently fall back to a
# deterministic regex-based canned-response engine (still responds, just
# much dumber, with no visible signal anything's wrong).
ANTHROPIC_API_KEY=
# MERIDIAN_LLM_MODEL=
GROQ_API_KEY=

# Voice — platform TTS (Retell / Vapi / Bland / Twilio Gather) always works with no keys set.
# Hosted premium voice (POST .../speak with { "audio": true }) requires ONE of:
XAI_API_KEY=
# Do NOT set VOICE_ENABLE_ELEVENLABS=1 until you want the optional plug-in
# VOICE_ENABLE_ELEVENLABS=0
# ELEVENLABS_API_KEY=

# Twilio — inbound SMS + Gather/Say voice on existing brain tokens (no xAI debit)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_TOKEN=
# JSON map of Twilio number → agent id
# TWILIO_AGENT_MAP={"+14155550100":"agent_xxx"}
# MERIDIAN_SMS_ALERTS=1
# TWILIO_SKIP_SIGNATURE=1
